# keep the build context small and secrets out of the image
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.pyc
*.log

# SECRET -- never bake the key into an image
.env
*.key

# the WCB model is rebuilt inside the image (do not ship a stale local copy)
Gold/wcb_model
space/wcb_model

# runtime caches + scraped third-party data (not needed, and not ours to ship)
Gold/.predict_cache.json
Gold/.predict_corrections.json
Gold/domain_*
Gold/yt_*
Gold/metrics.prom
Gold/lm_eval_out*

# large / unneeded for the demo container
docs/*.pdf
docs/*.png
docs/*.gif
dataset
First_round_Test
raw_texts.csv
scored_texts.csv
